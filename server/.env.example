# Скопіювати в .env (файл .env у .gitignore, у репозиторій не потрапляє)
# і підставити реальні значення.

# Локально — свій Postgres (напр. postgresql://postgres:postgres@localhost:5432/kingdom_dev?schema=public)
# На Railway — DATABASE_URL підставиться автоматично від плагіна PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kingdom_dev?schema=public"

PORT=3000

# Довгий випадковий рядок для підпису JWT — згенерувати один раз, напр.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Тримати лише в .env (локально) і в env-змінних Railway — ніколи в коді/репо.
JWT_SECRET=replace-with-a-long-random-string

# Кома-розділений список origin'ів, яким дозволено робити браузерні
# (cross-origin) запити до цього API. Порожньо/відсутнє -> усі браузерні
# cross-origin запити блокуються (безпечний дефолт). curl/Postman/
# сервер-до-сервера CORS не стосується.
CORS_ORIGIN=http://localhost:5173
