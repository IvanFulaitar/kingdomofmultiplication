// Мінімальна схема для кроку 1 (backend-mvp-plan.md, розділ 3) — лише
// таблиця users. Профілі/прогрес/покупки з backend-architecture-plan.md
// додаються пізніше окремими моделями, що посилаються на User.id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}
