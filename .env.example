# Скопіювати в .env (файл .env у .gitignore, у репозиторій не потрапляє).
# Адреса задеплоєного бекенду (server/) на Railway — використовується
# лише для акаунтів (реєстрація/логін), ігровий прогрес і далі в
# localStorage. Якщо не задано — фронтенд намагається достукатись до
# http://localhost:3000 (локальний `npm run dev` бекенду).
VITE_API_URL=https://kingdomofmultiplication-production.up.railway.app

# Акаунти (вхід/реєстрація, src/config.js) — поки серверна синхронізація
# прогресу не готова, форма входу прихована, а сторінка акаунта показує
# стан "У розробці"; гра й далі повністю грається без цього, прогрес — у
# localStorage. Не задано (як тут) або "false" — вимкнено (типовий стан
# зараз). Виставити "true", коли бекенд-синхронізація буде готова.
VITE_AUTH_ENABLED=false
